{
  "manifest_version": 3,
  "name": "Comic Translator",
  "version": "0.5.0",
  "description": "A React and TypeScript extension that detects text boxes with an on-device ONNX model.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "start-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Select comic images to translate"
    }
  },
  "action": {
    "default_title": "Comic Translator",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
