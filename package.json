{
  "name": "comic-translator-extension",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/prepare-assets.ts",
    "prebuild": "node scripts/prepare-assets.ts",
    "build": "export BUILD_ID=$(node -e 'process.stdout.write(String(Date.now()))') && npm run typecheck && vite build && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "dev:chrome": "bash scripts/dev-extension.sh"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
